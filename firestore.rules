rules_version = '2';

// ============================================================================
//  Vogolab — Firestore Güvenlik Kuralları
// ============================================================================
//  Bu dosya artık VERSİYON KONTROLÜNDE. Değişiklikler buradan yapılır ve
//  `firebase deploy --only firestore:rules` ile yayınlanır. Konsolda elle
//  değiştirmeyin — repo ile konsol ayrışır.
//
//  ── DURUM (2026-07-29) ─────────────────────────────────────────────────────
//  İstemciden Firestore'a YAZILMIYOR. Admin panelinin bütün yazma işlemleri
//  sunucu rotalarından geçiyor (Firebase Admin SDK, admin çerezi ile korumalı):
//        • leads   → src/app/api/admin/leads/route.ts
//        • içerik  → src/app/api/admin/content/route.ts
//  Sitede Firebase Auth yok; admin yalnız çerezle korunuyor ve Firestore o
//  çerezi göremiyor — bu yüzden koruma KURALDA değil, SUNUCUDA kurulmuştur.
//
//  Tek istisna: iletişim/teklif formunun `leads` create'i. Onu ziyaretçi
//  gönderiyor, admin çerezi yok — bu yüzden istemcide kalmalı ve kural
//  alan doğrulamasıyla (isValidLead) sınırlıyor.
//
//  ⚠️  Bir yazma "izin reddedildi" veriyorsa çözüm kuralı gevşetmek DEĞİL,
//      o çağrıyı sunucu rotasına taşımaktır.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── KİŞİSEL VERİ (KVKK) ────────────────────────────────────────────────
    // İletişim/teklif formları buraya YAZAR (create). Okuma/güncelleme/silme
    // istemciden TAMAMEN kapalı — kişisel veri (ad, telefon, e-posta, mesaj)
    // bir daha kimlik doğrulamasız GET ile dışarı sızmasın.
    // Admin bu koleksiyona sunucudan (Admin SDK) erişmeli.
    match /leads/{id} {
      allow create: if isValidLead();
      allow read, update, delete: if false;
    }

    // ── KAMUYA AÇIK İÇERİK ──────────────────────────────────────────────────
    // Site bu koleksiyonları render ediyor → okuma herkese açık.
    //
    // ✅ YAZMA KAPATILDI — 2026-07-29.
    //    Öncesinde "allow write: if true" idi: admin paneli içeriği client SDK
    //    ile yazıyordu ve sitede Firebase Auth yok. Bu, adresi bilen HERKESİN
    //    ajansın kendi sitesinin içeriğini, portföyünü ve blog yazılarını
    //    DEĞİŞTİREBİLMESİ demekti. Admin şifresi burada koruma sağlamaz —
    //    şifre paneli korur; Firestore'a REST üzerinden panelden hiç geçmeden
    //    erişilir ve kuralı uygulayan Google'ın sunucusudur.
    //
    //    Çözüm `leads` ile AYNI kalıp: yazma sunucuya taşındı.
    //      • rota   : src/app/api/admin/content/route.ts  (Admin SDK + admin çerezi)
    //      • istemci: src/lib/admin-write.ts              (adminSet/Update/Add/Delete)
    //      • çağrılar: src/lib/content.ts · src/lib/blog.ts
    //
    //    ⚠️ Bu kuralı geri açmayın. Admin panelinde "kaydedilemedi" görülürse
    //    sebep kural değil, sunucudaki gizli değişkendir (servis hesabı).
    match /siteContent/{id} { allow read: if true; allow write: if false; }
    match /projects/{id}    { allow read: if true; allow write: if false; }
    match /services/{id}    { allow read: if true; allow write: if false; }
    match /blog_posts/{id}  { allow read: if true; allow write: if false; }

    // ── VARSAYILAN: her şey kapalı ─────────────────────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}

// Formdan gelen lead belgesinin yalnız beklenen alanları taşımasını doğrular.
// (Kötü niyetli devasa/rastgele belge yazımını sınırlar.)
function isValidLead() {
  let d = request.resource.data;
  // Yalnız beklenen alanlar (fazlası reddedilir). Alanlar opsiyonel olabilir —
  // saveLead boş/undefined alanları eler — bu yüzden tip/boyut kontrolleri
  // yalnız alan MEVCUTSA uygulanır; böylece gerçek form gönderimi hiç kırılmaz.
  return d.keys().hasOnly([
    'name', 'phone', 'email', 'message', 'service', 'source', 'status',
    'createdAt', 'updatedAt'
  ])
  && (!('name' in d)    || (d.name is string    && d.name.size()    < 200))
  && (!('message' in d) || (d.message is string && d.message.size() < 5000))
  && (!('email' in d)   || (d.email is string   && d.email.size()   < 320));
}
